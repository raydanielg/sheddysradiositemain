#===========================================================================
# SHEDDY'S RADIO - Environment Configuration
# Radio Station Website & Admin Panel
#===========================================================================

#---------------------------------------------------------------------------
# Application Settings
#---------------------------------------------------------------------------
APP_NAME="Sheddy's Radio"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

# Timezone for radio schedules (Africa/Nairobi for East African Time)
APP_TIMEZONE=Africa/Nairobi

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

#---------------------------------------------------------------------------
# Logging
#---------------------------------------------------------------------------
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

#---------------------------------------------------------------------------
# Database Configuration
# Default: SQLite for quick local setup
# Uncomment MySQL section for production
#---------------------------------------------------------------------------
DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=sheddys_radio
# DB_USERNAME=root
# DB_PASSWORD=

# MySQL/MariaDB Unix Socket (for shared hosting)
# DB_SOCKET=/var/run/mysqld/mysqld.sock

#---------------------------------------------------------------------------
# Session & Cache
#---------------------------------------------------------------------------
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=sheddy_radio

#---------------------------------------------------------------------------
# Redis (for advanced caching/queues)
#---------------------------------------------------------------------------
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

#---------------------------------------------------------------------------
# Mail Configuration
# For contact forms and notifications
#---------------------------------------------------------------------------
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="info@sheddysradio.com"
MAIL_FROM_NAME="${APP_NAME}"

# SMTP Settings (for production)
# MAIL_MAILER=smtp
# MAIL_HOST=smtp.mailgun.org
# MAIL_PORT=587
# MAIL_USERNAME=your-mailgun-username
# MAIL_PASSWORD=your-mailgun-password
# MAIL_ENCRYPTION=tls

#---------------------------------------------------------------------------
# Radio Stream Settings
# Default stream URL for the radio player
# Can be overridden in admin panel (site_settings.stream_url)
#---------------------------------------------------------------------------
RADIO_STREAM_URL=https://stream.zeno.fm/yn65fsarcm0uv
RADIO_DEFAULT_VOLUME=0.8
RADIO_FM_FREQUENCY=99.5

#---------------------------------------------------------------------------
# File Storage (AWS S3 for media storage)
#---------------------------------------------------------------------------
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

#---------------------------------------------------------------------------
# Media Library (Spatie)
#---------------------------------------------------------------------------
MEDIA_DISK=public

#---------------------------------------------------------------------------
# Vite / Frontend
#---------------------------------------------------------------------------
VITE_APP_NAME="${APP_NAME}"

#---------------------------------------------------------------------------
# Security
#---------------------------------------------------------------------------
# Enable/Disable 2FA for admin (future feature)
# ADMIN_2FA_ENABLED=false

# reCAPTCHA for contact forms (future feature)
# RECAPTCHA_SITE_KEY=
# RECAPTCHA_SECRET_KEY=

#---------------------------------------------------------------------------
# Social Media Links
#---------------------------------------------------------------------------
SOCIAL_FACEBOOK=https://facebook.com/sheddysradio
SOCIAL_TWITTER=https://twitter.com/sheddysradio
SOCIAL_INSTAGRAM=https://instagram.com/sheddysradio
SOCIAL_YOUTUBE=https://youtube.com/sheddysradio
SOCIAL_WHATSAPP=

#---------------------------------------------------------------------------
# Analytics (future feature)
#---------------------------------------------------------------------------
# GOOGLE_ANALYTICS_ID=
# FACEBOOK_PIXEL_ID=
